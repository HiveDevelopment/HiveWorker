#!/bin/sh
set -eu
PORT=${PORT:-8080}
DOC_ROOT=${DOCUMENT_ROOT:-public}
case "$PORT" in ''|*[!0-9]*) echo "PORT must be a number" >&2; exit 1;; esac
if [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then echo "Use a Cell allocation between 1024 and 65535" >&2; exit 1; fi
case "$DOC_ROOT" in ''|/*|*..*|*[!a-zA-Z0-9_./-]*) echo "Document root must be a safe relative folder in your Cell" >&2; exit 1;; esac
SITE_ROOT=/home/container/$DOC_ROOT
[ -d "$SITE_ROOT" ] || { echo "Create your document root folder: $DOC_ROOT" >&2; exit 1; }
mkdir -p /tmp/hive-web
cat > /tmp/hive-web/nginx.conf <<EOF
worker_processes auto;
pid /tmp/hive-web/nginx.pid;
error_log /dev/stderr;
events { worker_connections 1024; }
http {
 include /etc/nginx/mime.types;
 default_type application/octet-stream;
 access_log /dev/stdout;
 server_tokens off;
 client_body_temp_path /tmp/hive-web/body;
 proxy_temp_path /tmp/hive-web/proxy;
 fastcgi_temp_path /tmp/hive-web/fastcgi;
 client_max_body_size 128m;
 server {
  listen $PORT;
  server_name _;
  root $SITE_ROOT;
  index index.php index.html;
  location / { try_files \$uri \$uri/ /index.php?\$query_string; }
  location ~ /\. { deny all; }
  location ~ \.php$ {
   try_files \$uri =404;
   include /etc/nginx/fastcgi_params;
   fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
   fastcgi_param HTTP_PROXY "";
   fastcgi_pass 127.0.0.1:9000;
   fastcgi_read_timeout 300s;
  }
 }
}
EOF
cat > /tmp/hive-web/php-fpm.conf <<'EOF'
[global]
pid = /tmp/hive-web/php-fpm.pid
error_log = /proc/self/fd/2
daemonize = no
[www]
listen = 127.0.0.1:9000
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 10s
pm.max_requests = 500
clear_env = no
catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php
php_admin_value[error_log] = /proc/self/fd/2
php_admin_flag[log_errors] = on
EOF
cat > /tmp/hive-web/supervisord.conf <<'EOF'
[supervisord]
nodaemon=true
logfile=/dev/null
pidfile=/tmp/hive-web/supervisord.pid
[program:nginx]
command=nginx -c /tmp/hive-web/nginx.conf -g "daemon off;"
autorestart=true
startsecs=2
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
stopasgroup=true
killasgroup=true
[program:php-fpm]
command=php-fpm --nodaemonize --fpm-config /tmp/hive-web/php-fpm.conf
autorestart=true
startsecs=2
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
stopasgroup=true
killasgroup=true
EOF
exec supervisord -c /tmp/hive-web/supervisord.conf
